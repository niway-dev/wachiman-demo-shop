+import type { CountersDto } from "@demo-shop/api-contract"
+
+/** Units in stock per product, as the api counted them. */
+export function StockTable({ stock }: { stock: CountersDto["stock"] }) {
+  return (
+    <section>
+      <h2>Stock</h2>
+      <table>
+        <thead>
+          <tr>
+            <th>Product</th>
+            <th className="num">Units in stock</th>
+          </tr>
+        </thead>
+        <tbody>
+          {stock.map((row) => (
+            <tr key={row.productId}>
+              <td>{row.name}</td>
+              <td className="num">{row.stock}</td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </section>
+  )
+}
