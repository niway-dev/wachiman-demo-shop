diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index e2f88ce..81aa706 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -42,7 +42,27 @@ jobs:
       - run: bun install --frozen-lockfile
       - run: bun check
 
+  # Pull requests that touch no application code skip the build and the tests.
+  changes:
+    runs-on: ubuntu-latest
+    outputs:
+      code: ${{ steps.filter.outputs.code }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - id: filter
+        run: |
+          code=true
+          if [ "${{ github.event_name }}" = "pull_request" ] \
+            && ! git diff --name-only "origin/${{ github.base_ref }}...HEAD" | grep -qE '^(apps|packages)/'; then
+            code=false
+          fi
+          echo "code=$code" >> "$GITHUB_OUTPUT"
+
   build:
+    needs: changes
+    if: needs.changes.outputs.code == 'true'
     runs-on: ubuntu-latest
     steps:
       - uses: actions/checkout@v4
@@ -83,7 +103,8 @@ jobs:
           echo 'total=2' >> "$GITHUB_OUTPUT"
 
   test:
-    needs: plan
+    needs: [plan, changes]
+    if: needs.changes.outputs.code == 'true'
     runs-on: ubuntu-latest
     strategy:
       fail-fast: false
@@ -136,15 +157,15 @@ jobs:
 
   ci-ok:
     if: always()
-    needs: [lint, format, typecheck, build, secrets, plan, test]
+    needs: [lint, format, typecheck, build, secrets, changes, plan, test]
     runs-on: ubuntu-latest
     steps:
-      - name: Fail if any job did not succeed
+      - name: Fail if any job failed
         env:
           RESULTS: ${{ toJSON(needs) }}
         run: |
           echo "$RESULTS"
-          if echo "$RESULTS" | grep -Eq '"result": "(failure|cancelled|skipped)"'; then
-            echo "A required job did not succeed."
+          if echo "$RESULTS" | grep -Eq '"result": "(failure|cancelled)"'; then
+            echo "A required job failed."
             exit 1
           fi
