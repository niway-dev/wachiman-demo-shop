# Copy to a local, gitignored env file. `bun run db:reset` and `bun run dev`
# generate one with a random secret when it is missing.
# Left empty on purpose: the api refuses to start until this holds a random secret.
BETTER_AUTH_SECRET=
DATABASE_PATH=data/shop.db
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
